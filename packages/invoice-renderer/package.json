{
  "name": "@facturion/invoice-renderer",
  "version": "0.8.1",
  "description": "Render the @facturion/invoice simplified-JSON model to a human-readable HTML invoice — the presentation layer behind Facturion's invoice PDFs.",
  "keywords": [
    "en16931",
    "einvoicing",
    "invoice",
    "html",
    "pdf",
    "renderer",
    "zugferd",
    "xrechnung",
    "factur-x"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facturion/packages.git",
    "directory": "packages/invoice-renderer"
  },
  "homepage": "https://github.com/facturion/packages/tree/main/packages/invoice-renderer#readme",
  "bugs": "https://github.com/facturion/packages/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./highlight": {
      "types": "./dist/src/highlight.d.ts",
      "default": "./dist/src/highlight.js"
    },
    "./styles/invoice.css": "./styles/invoice.css",
    "./styles/highlight.css": "./styles/highlight.css",
    "./styles/fonts.css": "./styles/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/fonts.ts",
    "!src/styles.ts",
    "styles",
    "fonts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "generate": "node scripts/generate-styles.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "prepare": "npm run generate",
    "pretest": "npm run generate",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@facturion/codelists": "^0.1.1",
    "@facturion/invoice": "^0.5.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^22.0.0",
    "linkedom": "^0.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
